  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Sandbox Windows",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/out/install/windows-msvc-debug-developer-mode/bin/dan_dan_the_game.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${fileDirname}",
      "environment": [],
      "console": "externalTerminal"
    },
    {
      "name": "Debug Sandbox Unix",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/out/install/unixlike-gcc-debug/bin/dan_dan_the_game",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${fileDirname}",
      "environment": [{"name":"SPDLOG_LEVEL", "value": "trace"}, {"name": "LD_LIBRARY_PATH", "value":"${workspaceFolder}/out/install/unixlike-gcc-debug/lib"}],
      "console": "externalTerminal"
    },
    {
      "name": "Debug Sandbox",
      "type": "cppdbg",
      "request": "launch",
      "program": "/home/ANT.AMAZON.COM/dwillans/devel/Evie/out/build/unixlike-gcc-debug/test/asset_manager_tests",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${fileDirname}",
      "environment": [{
        "name":"LD_LIBRARY_PATH", "value":"${workspaceFolder}/out/install/unixlike-clang-debug/lib"
      }],
      "externalConsole": false,
      "MIMode": "gdb",
      "setupCommands": [
          {
              "description": "Enable pretty-printing for gdb",
              "text": "-enable-pretty-printing",
              "ignoreFailures": true
          },
          {
              "description": "Set Disassembly Flavor to Intel",
              "text": "-gdb-set disassembly-flavor intel",
              "ignoreFailures": true
          }
      ]
    }

  ]
}